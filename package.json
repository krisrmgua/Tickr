{
  "name": "tickr",
  "productName": "Tickr",
  "version": "0.3.7",
  "description": "Stock ticker for the macOS menu bar and the Windows system tray",
  "main": "dist-electron/main.js",
  "author": "Kristopher Simmons",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:ui && npm run build:electron",
    "check": "npm run build:electron && node dist-electron/selfCheck.js",
    "start": "npm run build && electron .",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && TICKR_DEV=1 electron .\"",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack": "npm run build && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.krsimmons.tickr",
    "productName": "Tickr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "menubar/Resources/logos",
        "to": "logos",
        "filter": [
          "*.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  }
}
